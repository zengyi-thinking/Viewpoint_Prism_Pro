generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 用户与认证
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  avatarUrl    String?
  passwordHash String
  profile      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings     UserSettings?
  projects     Project[]
  chatSessions ChatSession[]

  @@map("users")
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  openaiKey       String?
  geminiKey       String?
  volcengineKey   String?
  aliyunAsrKey    String?
  midjourneyKey   String?
  seedanceKey     String?
  elevenlabsKey   String?
  notionToken     String?
  feishuAppId     String?
  feishuAppSecret String?

  // 优先使用硅基流动（Seedance），其他 Provider 为后续高端服务预留
  preferredAsr      String? @default("seedance")
  preferredLlm      String? @default("seedance")
  preferredImageGen String? @default("seedance")
  preferredVideoGen String? @default("seedance")
  preferredTts      String? @default("seedance")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

// ============================================================
// 工程管理
// ============================================================

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  videos       VideoSource[]
  chatSessions ChatSession[]

  @@index([userId])
  @@map("projects")
}

// ============================================================
// 视频源管理
// ============================================================

enum VideoSourceType {
  LOCAL_UPLOAD
  URL_IMPORT
  YOUTUBE
  BILIBILI
}

enum TaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model VideoSource {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  sourceType  VideoSourceType
  sourceUrl   String?
  storagePath String
  duration    Int?
  resolution  String?
  fileSize    BigInt?
  thumbnailUrl String?
  metadata    Json?

  transcriptStatus TaskStatus @default(PENDING)
  keyframeStatus   TaskStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transcripts       Transcript[]
  keyframes         Keyframe[]
  knowledgeAssets   KnowledgeAsset[]
  prismFlowProjects PrismFlowProject[]
  translationTasks  TranslationTask[]
  diffractionTasks  DiffractionTask[]

  behaviorEvents VideoBehaviorEvent[]
  sessions       VideoSession[]
  bookmarks      VideoBookmark[]
  notes          VideoNote[]
  highlights     VideoHighlight[]
  frameAnalyses FrameAnalysis[]
  frameInsights  FrameInsight[]
  deepAnalyses   KnowledgeDeepAnalysis[]

  @@index([projectId])
  @@map("video_sources")
}

// PLACEHOLDER_NEXT

// ============================================================
// 转写与关键帧
// ============================================================

model Transcript {
  id       String      @id @default(cuid())
  videoId  String
  video    VideoSource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  language String      @default("auto")
  provider String
  segments Json

  createdAt DateTime @default(now())

  @@index([videoId])
  @@map("transcripts")
}

enum KeyframeType {
  PPT
  WHITEBOARD
  CHART
  SCENE_CHANGE
  SPEAKER
}

model Keyframe {
  id          String       @id @default(cuid())
  videoId     String
  video       VideoSource  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  timestamp   Float
  frameType   KeyframeType
  storagePath String
  description String?
  similarity  Float?
  metadata    Json?

  createdAt DateTime @default(now())

  frameInsight FrameInsight?

  @@index([videoId, timestamp])
  @@map("keyframes")
}

// ============================================================
// 知识棱镜
// ============================================================

model KnowledgeAsset {
  id              String      @id @default(cuid())
  videoId         String
  video           VideoSource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  outlineMarkdown String      @db.Text
  notesMarkdown   String?     @db.Text
  profileSnapshot Json?
  status          TaskStatus  @default(PENDING)
  syncedTo        String[]    @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flashcards Flashcard[]
  crystalCards CrystalCard[]
  deepAnalyses KnowledgeDeepAnalysis[]

  @@index([videoId])
  @@map("knowledge_assets")
}

model FrameInsight {
  id          String      @id @default(cuid())
  videoId     String
  video       VideoSource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  keyframeId  String      @unique
  keyframe    Keyframe    @relation(fields: [keyframeId], references: [id], onDelete: Cascade)
  timestampSec Float
  ocrText     String?     @db.Text
  visualSummary String    @db.Text
  chapterHint String?
  chartType   String?
  visualType  String?
  formulaSignals Json?
  codeSignals Json?
  visualEntities Json?
  confidence  Float?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId, timestampSec])
  @@map("frame_insights")
}

model KnowledgeDeepAnalysis {
  id          String         @id @default(cuid())
  videoId     String
  video       VideoSource    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       KnowledgeAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  version     Int            @default(1)
  status      TaskStatus     @default(PENDING)
  summary     String?        @db.Text
  chapterGraphJson Json?
  conceptGraphJson Json?
  ambiguitiesJson Json?
  backgroundFactsJson Json?
  learningRecommendationsJson Json?
  sourceDigestJson Json?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId, createdAt])
  @@index([assetId])
  @@map("knowledge_deep_analyses")
}

model Flashcard {
  id          String         @id @default(cuid())
  assetId     String
  asset       KnowledgeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  front       String
  back        String
  chapter     String?
  difficulty  Int            @default(1)
  nextReview  DateTime?
  reviewCount Int            @default(0)

  createdAt DateTime @default(now())

  @@index([assetId])
  @@map("flashcards")
}

enum CrystalCardType {
  CONCEPT
  TIMELINE
  COMPARISON
  INSIGHT
  QUOTE
  KEYFRAME
  QA
  SUMMARY
}

enum PromptAssetType {
  CRYSTAL_CARD
  MINDMAP
  OUTLINE
  FLASHCARD
}

model GenerationQuality {
  id           String   @id @default(cuid())
  userId       String
  assetId      String?
  cardId       String?
  flashcardId  String?
  generatedBy  String
  templateId   String?
  // template: PromptTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  qualityScore Float
  dimensions   Json
  userFeedback String?
  userRating   Int?
  helpfulnessVotes Int @default(0)
  createdAt    DateTime @default(now())

  @@index([assetId])
  @@index([cardId])
  @@index([flashcardId])
  @@index([qualityScore])
  @@map("generation_quality")
}

model CrystalCard {
  id          String         @id @default(cuid())
  assetId     String
  asset       KnowledgeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  type        CrystalCardType @default(CONCEPT)
  title       String
  content     String         @db.Text
  summary     String?

  // 时间戳相关
  timestamp   Float?
  videoTime   String?

  // 视觉元素
  imageUrl    String?
  keyframeId  String?

  // 关联内容
  sourceText  String?        @db.Text
  sourceType  String?

  // 元数据
  tags        String[]       @default([])
  difficulty  Int            @default(1)
  importance  Int            @default(3)

  // AI 生成相关
  aiModel     String?
  aiPrompt    String?

  // 状态
  isFeatured  Boolean        @default(false)
  isVerified  Boolean        @default(false)

  // 排序和分组
  orderIndex  Int            @default(0)
  category    String?

  // 扩展数据
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId, type])
  @@index([assetId, orderIndex])
  @@map("crystal_cards")
}

// PLACEHOLDER_PRISMFLOW

// ============================================================
// 创作棱镜 (PrismFlow)
// ============================================================

model PrismFlowProject {
  id          String      @id @default(cuid())
  videoId     String
  video       VideoSource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  name        String
  stylePreset Json?
  scriptText  String?     @db.Text
  status      TaskStatus  @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodes FlowNode[]

  @@index([videoId])
  @@map("prismflow_projects")
}

model FlowNode {
  id            String           @id @default(cuid())
  flowProjectId String
  flowProject   PrismFlowProject @relation(fields: [flowProjectId], references: [id], onDelete: Cascade)

  positionX      Float   @default(0)
  positionY      Float   @default(0)
  orderIndex     Int
  prompt         String? @db.Text
  scriptSegment  String?

  firstFrameUrl    String?
  lastFrameUrl     String?
  firstFrameLocked Boolean    @default(false)
  lastFrameLocked  Boolean    @default(false)

  renderedVideoUrl String?
  renderStatus     TaskStatus @default(PENDING)

  parentNodeId String?
  branchName   String?
  isMerged     Boolean @default(false)

  narrationUrl String?
  bgmUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentNode    FlowNode?  @relation("NodeBranch", fields: [parentNodeId], references: [id])
  childBranches FlowNode[] @relation("NodeBranch")

  @@index([flowProjectId, orderIndex])
  @@map("flow_nodes")
}

// PLACEHOLDER_TRANSLATION

// ============================================================
// 译制棱镜
// ============================================================

model TranslationTask {
  id       String      @id @default(cuid())
  videoId  String
  video    VideoSource @relation(fields: [videoId], references: [id], onDelete: Cascade)

  sourceLang  String
  targetLangs String[]

  subtitleStatus   TaskStatus @default(PENDING)
  inpaintingStatus TaskStatus @default(PENDING)
  voiceCloneStatus TaskStatus @default(PENDING)
  lipSyncStatus    TaskStatus @default(PENDING)

  outputVideoUrl String?
  status         TaskStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subtitleTracks SubtitleTrack[]

  @@index([videoId])
  @@map("translation_tasks")
}

model SubtitleTrack {
  id            String          @id @default(cuid())
  translationId String
  translation   TranslationTask @relation(fields: [translationId], references: [id], onDelete: Cascade)

  language    String
  segments    Json
  srtContent  String?  @db.Text
  isConfirmed Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([translationId])
  @@map("subtitle_tracks")
}

// PLACEHOLDER_DIFFRACTION

// ============================================================
// 衍射棱镜
// ============================================================

model DiffractionTask {
  id      String      @id @default(cuid())
  videoId String
  video   VideoSource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId  String
  status  TaskStatus  @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformDrafts PlatformDraft[]

  @@index([videoId])
  @@index([userId])
  @@map("diffraction_tasks")
}

enum Platform {
  XIAOHONGSHU
  JIKE
  TWITTER_X
  WECHAT_MP
  NEWSLETTER
  LINKEDIN
  INSTAGRAM
}

model PlatformDraft {
  id            String          @id @default(cuid())
  diffractionId String
  diffraction   DiffractionTask @relation(fields: [diffractionId], references: [id], onDelete: Cascade)

  platform      Platform
  title         String?
  content       String   @db.Text
  hookLine      String?
  ctaLine       String?
  tone          String?
  emojiStrategy String?
  selectedImages Json?

  version     Int     @default(1)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([diffractionId, platform])
  @@map("platform_drafts")
}

// ============================================================
// 对话系统
// ============================================================

enum PrismType {
  KNOWLEDGE
  CREATION
  TRANSLATION
  DIFFRACTION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatSession {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  activePrism PrismType?
  videoId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([projectId, userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role         MessageRole
  content      String      @db.Text
  metadata     Json?
  prismAction  String?
  prismPayload Json?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// ============================================================
// 画面分析 (Chat 流式响应支持)
// ============================================================

model FrameAnalysis {
  id          String      @id @default(cuid())
  videoId     String
  video       VideoSource @relation(fields: [videoId], references: [id], onDelete: Cascade)

  timestamp   Float
  description String      @db.Text
  imageUrl    String?     // MinIO URL 或短期 Base64 存储
  detectedObjects Json?    // 识别到的物体列表
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([videoId, timestamp])
  @@index([videoId])
  @@index([timestamp])
  @@map("frame_analyses")
}

// ============================================================
// 任务队列记录
// ============================================================

model TaskRecord {
  id          String     @id @default(cuid())
  userId      String
  type        String
  payload     Json
  status      TaskStatus @default(PENDING)
  progress    Int        @default(0)
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId, status])
  @@index([type, status])
  @@map("task_records")
}

// ============================================================
// 视频行为追踪
// ============================================================

enum VideoEventType {
  PLAY
  PAUSE
  SEEK
  SPEED_CHANGE
  VOLUME_CHANGE
  FULLSCREEN
  PICTURE_IN_PICTURE
  END
  BUFFER
  ERROR
  CHAPTER_CHANGE
  BOOKMARK_ADD
  BOOKMARK_REMOVE
  NOTE_ADD
  HIGHLIGHT_ADD
  REGION_REPEAT
  REGION_SHARE
}

enum VideoActionContext {
  NORMAL
  KNOWLEDGE_PRISM
  CREATION_PRISM
  TRANSLATION_PRISM
  DIFFRACTION_PRISM
}

model VideoBehaviorEvent {
  id         String             @id @default(cuid())
  userId     String
  videoId    String
  video      VideoSource        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  session    VideoSession?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  eventType      VideoEventType
  context        VideoActionContext @default(NORMAL)
  sessionId      String? @unique

  // Event-specific data
  previousTime   Float?
  currentTime    Float
  playbackRate   Float    @default(1.0)
  volume         Float    @default(1.0)

  // Additional metadata
  metadata       Json?
  deviceId       String?
  userAgent      String?

  // Computed engagement metrics
  watchDuration  Float?   // Duration since last event (for session calculation)
  totalWatchTime  Float?   // Cumulative watch time (computed)
  engagementScore Float?   // Engagement score based on interaction pattern

  createdAt DateTime @default(now())

  @@index([userId, videoId, createdAt])
  @@index([videoId, eventType])
  @@index([sessionId])
  @@map("video_behavior_events")
}

model VideoSession {
  id          String   @id @default(cuid())
  userId      String
  videoId     String
  video       VideoSource @relation(fields: [videoId], references: [id], onDelete: Cascade)

  sessionId   String   @unique
  startTime   DateTime @default(now())
  endTime     DateTime?

  // Session metrics
  totalWatchTime    Float @default(0)
  activeWatchTime   Float @default(0) // Time video was actually playing
  pauseCount        Int @default(0)
  seekCount         Int @default(0)
  bufferCount       Int @default(0)

  // Coverage analysis
  watchedSegments   Json // Array of [start, end] pairs showing watched portions
  coveragePercent   Float @default(0) // Percentage of video watched

  // Completion status
  isCompleted       Boolean @default(false)
  completionTime    DateTime?

  // Context
  context           VideoActionContext @default(NORMAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events VideoBehaviorEvent[]

  @@index([userId, videoId])
  @@index([sessionId])
  @@map("video_sessions")
}

model VideoBookmark {
  id          String   @id @default(cuid())
  userId      String
  videoId     String
  video       VideoSource @relation(fields: [videoId], references: [id], onDelete: Cascade)

  timestamp   Float
  title       String
  description String?  @db.Text
  thumbnailUrl String?

  // Color coding for organization
  color       String?  @default("#3b82f6")

  // Tags for categorization
  tags        String[] @default([])

  // Context
  context     VideoActionContext @default(NORMAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, videoId, timestamp])
  @@map("video_bookmarks")
}

model VideoNote {
  id          String   @id @default(cuid())
  userId      String
  videoId     String
  video       VideoSource @relation(fields: [videoId], references: [id], onDelete: Cascade)

  timestamp   Float
  content     String   @db.Text
  timeRange   Json?    // [start, end] for notes covering a time range

  // Rich formatting support
  isMarkdown  Boolean  @default(true)
  attachments Json?    // Array of attachment references

  // Organization
  tags        String[] @default([])
  color       String?  @default("#10b981")

  // Linked assets
  linkedKnowledgeAssetId String?
  linkedFlashcardId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, videoId, timestamp])
  @@map("video_notes")
}

model VideoHighlight {
  id          String   @id @default(cuid())
  userId      String
  videoId     String
  video       VideoSource @relation(fields: [videoId], references: [id], onDelete: Cascade)

  startTime   Float
  endTime     Float
  title       String
  description String?  @db.Text

  // Color and style
  color       String   @default("#f59e0b")
  label       String?  // Short label shown on timeline

  // Type of highlight
  highlightType String @default("CUSTOM") // CUSTOM, KEY_POINT, QUOTE, SCENE, SPEAKER

  // Sharing
  isShared    Boolean  @default(false)
  shareToken  String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, videoId, startTime])
  @@map("video_highlights")
}
