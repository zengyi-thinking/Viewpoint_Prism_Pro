{
  "name": "viewpoint-prism-pro",
  "version": "0.1.0",
  "private": true,
  "description": "视频内容工作台 - 四大棱镜并行处理视频资产",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm --prefix ./server run start:dev",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm --prefix ./server run build",
    "db:generate": "npm --prefix ./server run prisma:generate",
    "db:push": "npm --prefix ./server run prisma:push",
    "db:studio": "npm --prefix ./server run prisma:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  }
}
