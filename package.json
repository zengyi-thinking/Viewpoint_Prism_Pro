{
  "name": "viewpoint-prism-pro",
  "version": "0.1.0",
  "private": true,
  "description": "视频内容工作台 - 四大棱镜并行处理视频资产",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run start:dev --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "db:generate": "npm run prisma:generate --workspace=server",
    "db:push": "npm run prisma:push --workspace=server",
    "db:studio": "npm run prisma:studio --workspace=server",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  }
}
