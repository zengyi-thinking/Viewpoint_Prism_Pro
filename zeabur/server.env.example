HOST=0.0.0.0
PORT=7871
BODY_PARSER_LIMIT=10mb

# Replace with your Zeabur Postgres private hostname and credentials.
DATABASE_URL=postgresql://postgres:password@postgres:5432/viewpoint_prism

# Preferred: one connection string for Zeabur Redis/Valkey.
REDIS_URL=redis://default:password@redis:6379

# Split variables also supported by the server if your Redis service exposes them separately.
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=password

JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_URL=https://your-frontend-domain.example
APP_PUBLIC_URL=https://your-frontend-domain.example
BYOK_ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string
FFMPEG_PATH=ffmpeg

# MinIO / S3
# Replace with your object storage private hostname or external S3 endpoint.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=viewpoint-prism

# Optional when the browser cannot reach the storage endpoint directly.
MINIO_PUBLIC_BASE_URL=https://your-frontend-domain.example
