# ============================================================
# 基础设施
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/viewpoint_prism
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_API_URL=http://localhost:3001
PORT=3001

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=viewpoint-prism

# ============================================================
# 认证
# ============================================================
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# AI 模型 API Keys（系统级默认，用户 BYOK 优先）
# ============================================================

# ------------------------------------------------------------
# 硅基流动（统一中转，推荐默认）
# ------------------------------------------------------------
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_ENABLED=true

# 可选：按能力指定默认模型（按你的账号可用模型填写）
SILICONFLOW_MODEL_LLM=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_MODEL_VLM=Qwen/Qwen2.5-VL-32B-Instruct
SILICONFLOW_MODEL_ASR=FunAudioLLM/SenseVoiceSmall
SILICONFLOW_MODEL_IMAGE=black-forest-labs/FLUX.1-schnell
SILICONFLOW_MODEL_VIDEO=Wan-AI/Wan2.2-T2V-A14B
# 可选：分别指定图生视频/文生视频模型（优先级高于 SILICONFLOW_MODEL_VIDEO）
SILICONFLOW_MODEL_VIDEO_I2V=Wan-AI/Wan2.2-I2V-A14B
SILICONFLOW_MODEL_VIDEO_T2V=Wan-AI/Wan2.2-T2V-A14B
SILICONFLOW_MODEL_TTS=FunAudioLLM/CosyVoice2-0.5B

# AI Router 策略
# siliconflow_first: 优先走硅基流动，失败后按备选
# premium_first: 优先走高端服务商，硅基流动兜底
AI_ROUTER_MODE=siliconflow_first
AI_ROUTER_FALLBACK_ENABLED=true
# 严格隔离：true=只使用用户当前选择的服务商，不跨服务商 fallback（推荐）
AI_ROUTER_STRICT_ISOLATION=true

# ASR - 语音识别
# 兼容 OpenAI SDK 的网关配置（默认指向硅基流动）
# 如果你代码里用 OpenAI 客户端，可以直接复用这组变量。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_TOKEN=
ALIYUN_ASR_ACCESS_KEY=
ALIYUN_ASR_ACCESS_SECRET=
ALIYUN_ASR_APP_KEY=

# LLM - 语言模型
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_NATIVE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL_CHAT=gemini-2.5-flash
GEMINI_MODEL_VISION=gemini-2.5-flash
GEMINI_MODEL_TRANSLATION=gemini-2.5-flash
GEMINI_MODEL_ASR=gemini-2.5-flash
# 高阶模型预留（按账号可用性填写）
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_IMAGE=gemini-2.5-flash-image
GEMINI_MODEL_VIDEO=veo-3.1-generate-preview
GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts

# 图片生成
MIDJOURNEY_API_KEY=
MIDJOURNEY_BASE_URL=

# 视频生成
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=

# TTS / Voice Clone
ELEVENLABS_API_KEY=

# ------------------------------------------------------------
# 高端服务预留接口（后续可无缝升级）
# ------------------------------------------------------------
# OpenAI 官方直连
OPENAI_PREMIUM_API_KEY=
OPENAI_PREMIUM_BASE_URL=https://api.openai.com/v1
OPENAI_PREMIUM_MODEL_CHAT=
OPENAI_PREMIUM_MODEL_VISION=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=

# Google Gemini / Vertex AI
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
VERTEX_MODEL=

# 高质量视频生成 / 编辑
RUNWAY_API_KEY=
PIKA_API_KEY=

# 专业翻译与语音增强（可选）
DEEPL_API_KEY=
ELEVENLABS_PREMIUM_API_KEY=

# ============================================================
# 外部同步
# ============================================================
NOTION_INTEGRATION_TOKEN=
NOTION_PARENT_PAGE_ID=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=

# ============================================================
# 加密
# ============================================================
BYOK_ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string

# ============================================================
# FFmpeg
# ============================================================
FFMPEG_PATH=ffmpeg
