# ============================================================
# 基础设施
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viewpoint_prism
REDIS_URL=redis://localhost:6379

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=viewpoint-prism

# ============================================================
# 认证
# ============================================================
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# AI 模型 API Keys（系统级默认，用户 BYOK 优先）
# ============================================================

# ASR - 语音识别
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_TOKEN=
ALIYUN_ASR_ACCESS_KEY=
ALIYUN_ASR_ACCESS_SECRET=
ALIYUN_ASR_APP_KEY=

# LLM - 语言模型
GEMINI_API_KEY=

# 图片生成
MIDJOURNEY_API_KEY=
MIDJOURNEY_BASE_URL=

# 视频生成
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=

# TTS / Voice Clone
ELEVENLABS_API_KEY=

# ============================================================
# 外部同步
# ============================================================
NOTION_INTEGRATION_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ============================================================
# 加密
# ============================================================
BYOK_ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string

# ============================================================
# FFmpeg
# ============================================================
FFMPEG_PATH=ffmpeg
